# Hospital node configuration (ARCHITECTURE §5). Copy to .env; .env is never committed.
APP_ENV=dev
DATABASE_URL=sqlite:///var/node_ksp.db

# Identity towards the hub (§17). The key file comes from `make keys`.
NODE_TENANT_ID=ten_ksp
HUB_AUDIENCE=sanovio-hub
NODE_SIGNING_KEY_FILE=.secrets/node_ksp_ed25519.pem
NODE_SIGNING_KID=ksp-2026-09

# Normalization at ingestion (D42, D56): the hospital's own Anthropic key.
# Needed only while articles are (re)normalized; serving requests never uses it.
# Set NORMALIZE_MODE=rules to seed without a key.
ANTHROPIC_API_KEY=
NORMALIZE_MODE=llm
NORMALIZE_BATCH_SIZE=25

# Egress controls (§16, D47, D48). Comma-separated attribute keys that never leave.
EGRESS_DENY_ATTRIBUTES=
SHARE_PRODUCT_HINTS=false
REQUIREMENT_RATE_LIMIT_PER_HOUR=120
ASSERTION_RATE_LIMIT_PER_HOUR=30
EGRESS_DAILY_ALERT_PER_USER=300

# Password given to the demo users by `make seed`; choose your own.
NODE_SEED_PASSWORD=change-me-before-seeding
