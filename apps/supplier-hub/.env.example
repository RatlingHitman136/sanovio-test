# Supplier hub configuration (ARCHITECTURE §5). Copy to .env; .env is never committed.
APP_ENV=dev
DATABASE_URL=sqlite:///var/hub.db
HUB_AUDIENCE=sanovio-hub
# Comma-separated origins of hospital SPAs (later phase); named origins only, never *.
CORS_ORIGINS=

# Sessions (§17): supplier and operator logins, exchanged purchaser sessions, assertion skew.
TOKEN_TTL_HOURS=8
EXCHANGE_TTL_MINUTES=30
ASSERTION_LEEWAY_S=60

# LLM (our key, not the hospitals'). `fake` runs every pipeline deterministically offline;
# `anthropic` needs the key (paste it after the = sign, no quotes).
LLM_MODE=fake
ANTHROPIC_API_KEY=
NORMALIZE_ITEM_MODEL=claude-sonnet-5
NORMALIZE_ITEM_EFFORT=medium
JUDGE_MODEL=claude-opus-5
JUDGE_EFFORT=high
EXTRACT_ANSWER_MODEL=claude-haiku-4-5
PROPOSE_ATTRIBUTE_MODEL=claude-sonnet-5
PROPOSE_ATTRIBUTE_EFFORT=medium
SIMULATE_SUPPLIER_MODEL=claude-haiku-4-5

# The assessment loop (§11, §12): rounds before a manual decision; the job worker thread
# (set false when `supplier-hub worker` runs as its own process).
MAX_ROUNDS=3
WORKER_ENABLED=true

# Password given to the demo supplier and operator users by `make seed`; choose your own.
HUB_SEED_PASSWORD=change-me-before-seeding
