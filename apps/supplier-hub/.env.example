# Supplier hub configuration (ARCHITECTURE §5). Copy to .env; .env is never committed.
APP_ENV=dev
DATABASE_URL=sqlite:///var/hub.db
HUB_AUDIENCE=sanovio-hub
# Comma-separated origins of hospital SPAs (later phase).
CORS_ORIGINS=

# Sessions.
TOKEN_TTL_HOURS=8
EXCHANGE_TTL_MINUTES=30

# LLM (our key, not the hospitals'). `fake` runs deterministically offline.
LLM_MODE=fake
ANTHROPIC_API_KEY=
NORMALIZE_ITEM_MODEL=claude-sonnet-5
JUDGE_MODEL=claude-opus-5
MAX_ROUNDS=3

# Password given to the demo supplier and operator users by `hub seed`.
HUB_SEED_PASSWORD=change-me-before-seeding
