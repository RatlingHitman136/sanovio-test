@startuml 03_packages
!pragma layout smetana
!include _style.iuml
title Project structure: uv workspace and allowed package dependencies

frame "sanovio/ (uv workspace root: pyproject.toml, uv.lock)" {
  frame "packages/equivalence-core" #FFF3E0 {
    package "values, hashing,\nids, quality\n(shared primitives)" as core_primitives
    package "templates" as core_templates
    package "parsers" as core_parsers
    package "identifiers" as core_identifiers
    package "validation\n(value vs definition)" as core_validation
    package "comparators" as core_comparators
    package "facts\n(precedence, record_hash)" as core_facts
    package "verdict_rules" as core_verdict_rules
    package "identifier_evidence\n(SAME_TRADE_ITEM |\nNO_INFORMATION)" as core_identifier_evidence
    package "exchange\n(requirement, assertion, jws)" as core_exchange
  }

  frame "packages/service-kit" #ECEFF1 {
    package "db (base, UTC, UUIDv7),\nclock, security, errors" as service_kit
  }

  frame "packages/llm-client" #F3E5F5 {
    package "client (LLMClient,\nStructuredRequest, CallRecord)" as llm_client
    package "anthropic_client,\nfake_client, pricing, prompts" as llm_client_impl
  }

  frame "apps/hospital-node" #E3F2FD {
    package "main.py" as node_main
    package "api/v1" as node_api
    package "core\n(settings, db, clock, security,\nsecrets loader, migrations)" as node_core
    package "models / schemas" as node_models
    package "services\n(articles, facts, normalization,\nprojection, requirement_builder,\nassertion_signer, reference_link,\negress_log, llm_calls, seed,\nauth, user_directory, template_sync)" as node_services
    package "llm\n(normalize_article,\ningestion only)" as node_llm
    package "alembic, seed data, tests" as node_misc
  }

  frame "apps/supplier-hub" #E8F5E9 {
    package "main.py" as hub_main
    package "api/v1" as hub_api
    package "core\n(settings, db, migrations)" as hub_core
    package "models / schemas" as hub_models
    package "services\n(auth, tenants_keys, token_exchange,\nrequirement_intake, candidate_search,\ncatalog, normalization, projection,\nattribute_registry, templates, seed,\nassessment, questions, enrichment,\nresolution)" as hub_services
    package "domain\n(state_machine,\nstop_conditions)" as hub_domain
    package "llm\n(client, pipelines, prompts)" as hub_llm
    package "jobs" as hub_jobs
    package "alembic, seed data,\nevals, tests" as hub_misc
  }

  frame "tools/demo-client" {
    package "demo_client\n(typer + httpx + rich)" as demo_client
  }
  package "tests/e2e" as e2e
  package "http" as http
  package "charts, docs" as docs
  package ".secrets/, var/\n(git-ignored)" as git_ignored
}

node_main ..> node_api
node_api ..> node_services
node_api ..> node_core
node_services ..> node_models
node_models ..> node_core
node_services ..> node_llm
node_llm ..> llm_client
node_core ..> service_kit
hub_core ..> service_kit
hub_llm ..> llm_client
llm_client_impl ..> llm_client
node_services ..> core_exchange
node_services ..> core_facts
node_services ..> core_parsers
node_services ..> core_identifiers
node_services ..> core_validation

hub_main ..> hub_api
hub_main ..> hub_jobs
hub_api ..> hub_services
hub_api ..> hub_core
hub_services ..> hub_domain
hub_services ..> hub_models
hub_services ..> hub_llm
hub_jobs ..> hub_services
hub_models ..> hub_core
hub_services ..> core_exchange
hub_services ..> core_comparators
hub_services ..> core_facts
hub_services ..> core_verdict_rules
hub_services ..> core_identifier_evidence
hub_llm ..> core_templates

core_comparators ..> core_parsers
core_facts ..> core_templates
core_parsers ..> core_templates
core_verdict_rules ..> core_templates
core_identifier_evidence ..> core_identifiers
core_validation ..> core_templates
core_validation ..> core_parsers
core_facts ..> core_identifiers
core_exchange ..> core_identifiers
core_templates ..> core_primitives
core_parsers ..> core_primitives
core_facts ..> core_primitives
core_exchange ..> core_primitives
core_identifiers ..> core_primitives

demo_client ..> node_api : HTTP only
demo_client ..> hub_api : HTTP only
e2e ..> demo_client
http ..> node_api : HTTP
http ..> hub_api : HTTP

node_services -[#C62828,dashed]-> hub_services : <<forbidden>>
hub_services -[#C62828,dashed]-> node_services : <<forbidden>>

note bottom of core_exchange
  import-linter contracts:
  - hospital_node and supplier_hub never import each other
  - equivalence_core imports neither app, no llm_client and no
    FastAPI / SQLAlchemy / anthropic
  - llm_client and service_kit import no app and no domain code
  - the apps reach the Anthropic SDK only through llm_client
  - hospital_node imports no HTTP client (httpx, requests)
  - demo_client imports neither app
end note

@enduml
