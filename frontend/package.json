{
  "name": "sanovio-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "gen": "openapi-typescript ../openapi/node.json -o packages/api/src/generated/node.ts && openapi-typescript ../openapi/hub.json -o packages/api/src/generated/hub.ts && prettier --write packages/api/src/generated",
    "lint": "eslint . && prettier --check . && npm run typecheck --workspaces --if-present",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "build": "npm run build --workspace apps/purchaser --workspace apps/supplier",
    "dev": "npm run dev --workspace apps/purchaser & npm run dev --workspace apps/supplier & wait",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
